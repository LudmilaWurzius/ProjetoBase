        <isolate_script>true</isolate_script>
        <messages/>
        <name>Bloquear Campos se Já Estiver Alocado</name>
        <order/>
        <script><![CDATA[function onLoad() {
(function executeRule(current, gForm, gSNC) {
    var userID = gUser.userID; // Obtém o ID do usuário logado
    var userHasBase = false;

    var userEnrollment = new GlideRecord('x_1546361_bases_access_registration');
    userEnrollment.addQuery('requester_name', userID);
    userEnrollment.query();

    while (userEnrollment.next()) {
        if (userEnrollment.state != '0') { // Se já estiver em uma base, bloqueia
            userHasBase = true;
            break;
        }
    }

    if (userHasBase) {
        gForm.addInfoMessage("⚠️ Você já está alocado em uma base. Entre em contato com o Base Manager.");
        gForm.setReadOnly(true); // Bloqueia todos os campos do formulário
    }
})(current, gForm, gSNC);

   
}]]></script>
