        <description>Allow create for records in x_1546361_bases_access_registration, if the ACL script returns true.</description>
        <local_or_existing>Local</local_or_existing>
        <name>x_1546361_bases_access_registration</name>
        <operation display_value="create">create</operation>
        <script><![CDATA[// Se o usuário for admin da base, permite criação
if (gs.hasRole('x_1546361_bases.admin - bases')) {
    answer = true;
}

// Se o usuário for comum e estiver criando seu próprio registro, permite
if (gs.hasRole('x_1546361_bases.user - bases')) {
    answer = true;
}

// Se não for admin ou user, bloqueia
answer = false;
]]></script>
