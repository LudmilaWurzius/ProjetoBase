        <description/>
        <mobile_callable>false</mobile_callable>
        <name>FilterBasesWithCapacity</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var FilterBasesWithCapacity = Class.create();
FilterBasesWithCapacity.prototype = {
    initialize: function() {},

    getAvailableBases: function() {
        var availableBases = [];
        var baseGR = new GlideRecord('x_1546361_bases_bases');

        baseGR.addQuery('maximum_capacity', '>', 0); // Apenas bases com capacidade maior que 0
        baseGR.query();

        while (baseGR.next()) {
            availableBases.push(baseGR.sys_id.toString());
        }

        if (availableBases.length > 0) {
            return 'sys_idIN' + availableBases.join(',');
        }

        return 'sys_idINNONE'; // Caso nenhuma base esteja disponível
    },

    type: 'FilterBasesWithCapacity'
};
]]></script>
